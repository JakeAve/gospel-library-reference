{
  "lock": false,
  "version": "0.1.18",
  "minimumDependencyAge": {
    "age": "P1D",
    "exclude": ["jsr:@jakeave/scripture-ref"]
  },
  "tasks": {
    "setup": "git config core.hooksPath .githooks && chmod +x .githooks/pre-commit .githooks/pre-push",
    "check": "deno fmt --check && deno lint && deno check **/*.ts && deno check **/*.tsx",
    "test": "deno test -A --no-check",
    "pre-commit": "deno task check",
    "pre-push": "deno task check && deno task test",
    "start": "vite",
    "build": "vite build && cp dist/index.html dist/404.html",
    "preview": "vite preview",
    "version": "deno run --allow-read=./components/Header.tsx,./deno.json --allow-write=./components/Header.tsx,./deno.json ./scripts/updateVersion.ts"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "fmt": {
    "exclude": ["static/"]
  },
  "exclude": ["dist/", ".vite/"],
  "imports": {
    "@deno/vite-plugin": "npm:@deno/vite-plugin@^2.0.4",
    "@jakeave/scripture-ref": "jsr:@jakeave/scripture-ref@^0.0.11",
    "@std/assert": "jsr:@std/assert@^1.0.11",
    "preact": "npm:preact@^10.29.1",
    "@preact/signals": "npm:@preact/signals@^2.9.0",
    "vite": "npm:vite@^7.1.3",
    "@types/babel__core": "npm:@types/babel__core@^7.20.5",
    "lean-qr": "npm:lean-qr@^2.7.4",
    "fastest-levenshtein": "npm:fastest-levenshtein@^1.0.16"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "types": ["vite/client"]
  },
  "nodeModulesDir": "manual"
}
